POSTGRES_DB=auditlog
POSTGRES_USER=auditlog
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/auditlog
AUDIT_RETENTION_DAYS=90
AUDIT_REDACTION_MASTER_KEY_BASE64=replace-with-base64-encoded-32-byte-key
AUDIT_EXPORT_SIGNING_KEY_ID=replace-with-export-signing-key-id
AUDIT_EXPORT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-ed25519-private-key

# Configure prototype HTTP Basic users through environment variables.
# Spring Boot relaxed binding maps indexed variables into audit.security.users.
# Passwords should be BCrypt or another Spring Security password-encoder format.
AUDIT_SECURITY_USERS_0_USERNAME=audit-writer
AUDIT_SECURITY_USERS_0_PASSWORD={bcrypt}replace-with-bcrypt-hash
AUDIT_SECURITY_USERS_0_ROLES_0=AUDIT_WRITER

AUDIT_SECURITY_USERS_1_USERNAME=audit-reader
AUDIT_SECURITY_USERS_1_PASSWORD={bcrypt}replace-with-bcrypt-hash
AUDIT_SECURITY_USERS_1_ROLES_0=AUDIT_READER

AUDIT_SECURITY_USERS_2_USERNAME=audit-verifier
AUDIT_SECURITY_USERS_2_PASSWORD={bcrypt}replace-with-bcrypt-hash
AUDIT_SECURITY_USERS_2_ROLES_0=AUDIT_VERIFIER

AUDIT_SECURITY_USERS_3_USERNAME=audit-admin
AUDIT_SECURITY_USERS_3_PASSWORD={bcrypt}replace-with-bcrypt-hash
AUDIT_SECURITY_USERS_3_ROLES_0=AUDIT_ADMIN

AUDIT_SECURITY_USERS_4_USERNAME=compliance-reviewer
AUDIT_SECURITY_USERS_4_PASSWORD={bcrypt}replace-with-bcrypt-hash
AUDIT_SECURITY_USERS_4_ROLES_0=COMPLIANCE_REVIEWER
